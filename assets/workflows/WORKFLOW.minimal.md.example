---
interface_language: zh
# ============================================================================
# tracker: 结构化任务源 (Jira)
# ============================================================================
tracker:
  # 必填。仅支持 "jira"。
  kind: jira

  # Jira REST API 端点。Cloud: https://your-domain.atlassian.net/rest/api/3
  # 自托管: http://your-host:port/rest/api/2
  endpoint: https://your-domain.atlassian.net/rest/api/3

  # 必填。Jira API token。建议用 $VAR 环境变量引用，不写明文。
  # Cloud: 账号设置 → 安全 → 创建 API token
  # 自托管: 用户管理 → 生成 PAT
  api_key: $JIRA_API_TOKEN

  # basic 模式必填 (Cloud email 或自托管用户名)。bearer 模式可省略。
  api_user: you@example.com

  # 认证模式。"basic" = email + token (Cloud 常用)；"bearer" = 仅 token (自托管 PAT)
  auth_mode: basic

  # review 交接态名称。minimal 不用 review 暂停（无 MR），设 null。
  # 若需 review 暂停，填状态名（如 "代码评审中"）；该状态不放在 active/terminal 中即成隐式中间态。
  review_state: null

  # 必填。Jira 项目 key (如 "ENG")。与 project_slug 二选一。
  project_key: ENG

  # project_key 的替代，二选一即可。
  project_slug: null

  # 按指派人过滤。null = 不过滤 (拉取项目内所有符合状态的)。"me" = currentUser() (当前 API 用户)。
  assignee: null

  # 必需标签过滤。空 = 不过滤。如 ["tothemax"] 表示只派发含此标签的 issue。
  required_labels: []

  # 候选状态。只拉取处于这些状态的 issue 作为派发候选。
  # 注意: 不同的 Jira 部署状态名可能不同，需根据实际调整。
  # 三层状态模型: active(派发) / neither-review(停 worker 保留工作区) / terminal(清理工作区)。
  # minimal：active→处理→terminal 两态丝滑流，无 review 桶。
  active_states:
    - 待办
    - 处理中

  # 终态。处于这些状态的 issue 不会被派发，且启动时清理其工作区。
  terminal_states:
    - 完成
    - 关闭
    - 取消
    - 重复

# ============================================================================
# polling: 轮询节奏
# ============================================================================
polling:
  # 轮询间隔 (毫秒)。默认 30000 = 30 秒。必须 > 0。
  interval_ms: 30000

# ============================================================================
# workspace: per-task 工作区
# ============================================================================
workspace:
  # 工作区根目录。~ 会展开为 home。相对路径基于 WORKFLOW.md 所在目录。
  # 每个 issue 的工作区为 <root>/<sanitized_identifier>。
  root: ~/tasking_workspaces

# ============================================================================
# hooks: 工作区生命周期钩子 (可选)
# ============================================================================
hooks:
  # 所有 hook 的超时 (毫秒)。默认 60000 = 60 秒。必须 > 0。
  timeout_ms: 60000

  # 仅新工作区创建时运行。失败中止创建。常用于 git clone + 依赖安装。
  after_create: null

  # 每次 attempt 前运行。失败中止当前 attempt。
  # before_run: |
  #   git pull --ff-only origin main

  # 每次 attempt 后运行 (成功/失败/超时均执行)。失败仅记录。
  after_run: null

  # 工作区删除前运行 (issue 进入终态时)。失败仅记录，不阻塞删除。
  # before_remove: |
  #   cd elixir && mix workspace.before_remove

# ============================================================================
# agent: 并发与重试策略
# ============================================================================
agent:
  # 全局并发上限。同时运行的 opencode run 子进程数不超过此值。
  max_concurrent_agents: 10

  # 同一 worker 内的 turn 上限。达到后 worker 退出，调度续轮 retry。
  # 建议起步设 3 避免首次 token 消耗过大。
  max_turns: 20

  # 退避上限 (毫秒)。默认 300000 = 5 分钟。
  max_retry_backoff_ms: 300000

  # 按状态限并发。空 = 不限。如 {"in progress": 2} 限制 In Progress 状态最多 2 个并发。
  max_concurrent_agents_by_state: {}

# ============================================================================
# opencode: worker 子进程配置
# ============================================================================
opencode:
  # opencode 启动命令。默认 "opencode run"。
  command: opencode run

  # opencode agent profile 名称。
  agent: build

  # 可选。已知 opencode agent profile 的咨询性目录（字符串数组）。供 `/agent` 命令展示并对未知名提示。
  # 空目录（默认）＝不校验，任何 `agent:<name>` 直通；非空＝咨询性校验，未知名警告并回退默认。不作硬白名单。
  agents: []

  # 可选。opencode 模型 (provider/model 格式)，映射 `--model`。默认 null（不配置，走 opencode 默认模型）。
  model: null

  # 可选。模型变体 (provider 特定推理档位，如 high/max/minimal)，映射 `--variant`。默认 null（不配置）。与 model 彼此独立。
  variant: null

  # 单 turn 超时 (毫秒)。默认 3600000 = 1 小时。必须 > 0。
  # 硬墙钟超时：无论活动状态如何，到点必杀。
  turn_timeout_ms: 3600000

  # 停滞超时 (毫秒)。超过此时间无活动则终止 worker。
  # 默认 7200000 = 2 小时。设为 0 禁用停滞检测。
  # scheduler 层兜底：当不活跃超时和墙钟超时都无法终止子进程时
  # （如子进程拒绝响应 SIGTERM）。超时先 SIGTERM，10s 宽限未退出则
  # 进程组 SIGKILL（见 docs/adr/0020）；本项仅兜底升级路径自身失效。
  # 建议设为大于 turn_timeout_ms 以避免正常 turn 被误杀。
  stall_timeout_ms: 7200000

  # 不活跃超时 (毫秒)。stdout/stderr 无数据超过此值则 SIGTERM 终止。
  # 默认 600000 = 10 分钟。设为 0 禁用不活跃超时。
  # subprocess 层：检查原始字节，收到数据时重置计时器。
  inactivity_timeout_ms: 600000

# ============================================================================
# router: 非结构化源 (飞书) 的 route agent 分诊
# ============================================================================
  # 未实现：当前仅解析，无运行时代码（预留供将来 route agent 实现）。
# router:
  # 是否启用 route agent。启用后按 tick 有界运行，将飞书消息分诊为 Task。
  # enabled: false

  # route agent 使用的 opencode agent profile。
  # agent: triage

  # 单次 route agent 运行处理的 inbox 条目上限。
  # batch_size: 20

  # route agent 单次运行超时 (毫秒)。默认 120000 = 2 分钟。
  # timeout_ms: 120000

# ============================================================================
# feishu: 飞书 ↔ Jira 评论桥 (REST 轮询，无公网端口)
# ============================================================================
feishu:
  # 启用后飞书成已存在 Jira issue 的评论同步镜像：话题 1:1 绑定 issue，双向镜像评论。
  # 入站用 REST 轮询（不收 webhook、不暴露公网端口）。详见 docs/feishu-quickstart.md。
  enabled: false

  # 飞书版本：feishu（国内版 open.feishu.cn）| lark（海外版 open.larksuite.com）。默认 feishu。
  edition: feishu

  # 飞书应用凭证。可明文，也可用 $VAR 环境变量引用。
  app_id: $FEISHU_APP_ID
  app_secret: $FEISHU_APP_SECRET

  # intake 群 chat_id：承载所有 issue 线程的指定群（GET /im/v1/chats 取）。启用时必填。
  intake_chat_id: $FEISHU_INTAKE_CHAT_ID

  # 桥同步轮询节奏（毫秒），默认 5s。绑定线程定向轮询。
  forward_interval_ms: 5000        # Jira→飞书评论镜像节奏，默认 5s；收消息走事件通道
  sweep_interval_ms: 43200000      # 兜底清扫节奏（丢失补拉），默认 12h

  # /issue 默认 issueType（tasking init 时列出项目可用 type）。启用时必填。
  create_issue_type: Task

  # webhook 模式专用（REST 轮询下不用，预留供将来 webhook 模式）。
  # verification_token: $FEISHU_VERIFICATION_TOKEN
  # encrypt_key: $FEISHU_ENCRYPT_KEY

  # --------------------------------------------------------------------------
  # 直连会话 (feishu.direct)：绕过 Jira，在固定目录直接跑 opencode。
  # feishu.enabled 为 true 时直连默认启用；段内 enabled: false 显式关闭。详见 docs/configuration.md。
  # --------------------------------------------------------------------------
  direct:
    # 段内显式 false 关闭直连。
    enabled: true

    # 项目名 → 目录映射，供 `/chat <项目名> <消息>` 使用。对象形态 {path, auto_approve} 覆盖全局值。
    # 例：
    #   projects:
    #     tasking: /home/me/workspace/tasking
    #     other: {path: /abs/dir, auto_approve: true}
    projects:

    # ad-hoc path 模式（`/chat /绝对路径 <消息>`）的目录前缀白名单；空 = 不限制。
    path_roots: []

    # true = 给 opencode run 传 --auto（自动放行未被显式拒绝的权限）。
    # 默认 false：权限姿态由目标目录自己的 .opencode 权限配置决定。
    auto_approve: false

    # 镜像到飞书的事件量级：quiet（仅最终正文）| summary（正文 + 统计行）| detailed（默认，每 turn 一张过程卡片；折叠面板需飞书/Lark 客户端 >= V7.9）。
    verbosity: detailed

    # 直连 turn 的全局并发上限（独立于 Jira 的 max_concurrent_agents）；同目录/同会话始终串行。
    max_concurrent: 5

    # 空闲多久后把会话标记为 expired（毫秒，不删除 opencode 磁盘 session）。默认 2592000000 = 30 天。
    idle_ttl_ms: 2592000000

# ============================================================================
# server: HTTP 仪表板 (可选)
# ============================================================================
server:
  # 仪表板端口。null = 不启动。设为 8080 则启动。
  port: null

  # 绑定地址。"0.0.0.0" = 全网卡 (外部可访问)。"127.0.0.1" = 仅本地。
  host: 0.0.0.0

# ============================================================================
# logging: 文件日志 (可选)
# ============================================================================
logging:
  file:
    # 文件日志路径。null = 不写文件 (仅 stderr)。CLI 启动时默认为 ./tasking.log。
    path: null

    # 单文件最大字节数。超出后轮转。默认 10485760 = 10 MB。
    max_bytes: 10485760

    # 轮转备份数。保留最近 N 个备份文件。
    max_files: 5

# ============================================================================
# env: 注入 worker 子进程的环境变量 (可选)
# ============================================================================
# 值支持 $VAR 间接引用 (与 tracker.api_key 相同语义)。
# 解析为空字符串时注入空字符串值。缺失的 env 段默认为空对象。
env:
  # GitLab token，供 glab CLI 使用（minimal 通常不用 MR，可留空或按需配置）。
  GITLAB_TOKEN: $GITLAB_TOKEN
  GITLAB_HOST: $GITLAB_HOST
---

You are a coding agent working on: {{ task.identifier }} - {{ task.title }}

{% if task.description %}
## Description
{{ task.description }}
{% endif %}

## State model

- **Active** ({{ active_states }}): the scheduler dispatches you here.
- **Terminal** ({{ terminal_states }}): the scheduler removes the workspace.

This minimal workflow has no review pause and no merge request. Do the task in the working directory, upload the results to Jira, then transition to a terminal state.

## Workflow

1. Query available transitions via the `jira_rest` MCP tool (`GET /issue/{{ task.identifier }}/transitions`). Transition from the current state to the active state whose name semantically means "in progress / working" — pick the id by semantic match, do NOT hardcode the transition id. Skip if already in progress.
2. Complete the task in the working directory. Work directly here — do NOT create a git branch, do NOT create a merge request, do NOT use `glab`. (If the task genuinely requires a code merge request, ask the human to switch this task's workflow; do not improvise one here.)
3. Upload the results to Jira:
   - Add a summary comment via the `jira_rest` MCP tool (`POST /issue/{{ task.identifier }}/comment`) describing what you did, the outcome, and any caveats.
   - If you produced output files (reports, logs, screenshots, documents), upload them as Jira attachments via the `jira_upload_attachment` MCP tool.
4. Query available transitions again (`GET /issue/{{ task.identifier }}/transitions`). Transition to a terminal state whose name semantically means "done / completed" — pick the id by semantic match, do NOT hardcode it. The scheduler will then remove the workspace.

{% if attempt %}
This is attempt {{ attempt }}. If a previous attempt left partial work, inspect the working directory and Jira comments to resume; otherwise start the workflow above. If stuck, check `tasking.log` for execution failures.
{% endif %}

## Tracking

- Always add a summary comment before finishing, describing what you did.
- If you have output files, upload them as attachments via `jira_upload_attachment`.
- Do NOT transition to a terminal state until the results are uploaded.
