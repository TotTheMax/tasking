# Credentials for the daemon (WORKFLOW.md $VAR references) and the e2e real-API tests.
# Copy to `.env` and fill in your own environment:
#   cp .env.example .env
# Precedence: real shell env > `.env` file. There are no committed defaults.
# The daemon loads `.env` from the WORKFLOW.md directory at startup (tasking start / doctor).
# `.env` is gitignored — keep your personal values out of the repo.

# Daemon: referenced from WORKFLOW.md front matter ($VAR).
JIRA_API_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
GITLAB_TOKEN=

# Feishu e2e set: a dedicated test bot + test group (not the production bot).
FEISHU_E2E_APP_ID=
FEISHU_E2E_APP_SECRET=
FEISHU_E2E_INTAKE_CHAT_ID=

# Jira e2e set: endpoint + PAT that can access the TEST project.
JIRA_E2E_ENDPOINT=
JIRA_E2E_API_KEY=
JIRA_E2E_PROJECT_KEY=
